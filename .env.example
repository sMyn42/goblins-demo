DATABASE_URL=postgres://localhost:5432/goblins
APP_ORIGIN=http://localhost:3000
# Fresh local Postgres only. On Supabase enable Queues and select existing.
PGMQ_INSTALL_MODE=sql

# Local disk is for local testing only. Cloud Run requires private Supabase Storage.
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.data/images
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=student-work

# Normal grading uses live inference. Reuse the key in your existing ignored .env.
APP_MODE=normal
OCR_PROVIDER=openrouter
GRADING_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_OCR_MODEL=google/gemini-3.5-flash
OPENROUTER_GRADING_MODEL=openai/gpt-6-luna
OCR_MAX_TOKENS=4096
GRADING_MAX_TOKENS=4096
OCR_TIMEOUT_MS=15000
GRADING_TIMEOUT_MS=20000

WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=120
WORKER_MAX_ATTEMPTS=3
WORKER_POLL_MS=1000
# Worker only: default HTTP health port is 8081. Cloud Run provides PORT.
# PORT=8081
MOCK_LATENCY_MS=500
MOCK_SEED=42
MOCK_FAILURE_MODE=none
MOCK_FAILURE_RATE=0
# Mock profiles apply only with explicit APP_MODE=test or APP_MODE=load-test
# and OCR_PROVIDER=mock / GRADING_PROVIDER=mock on an isolated test database.
# MOCK_FAILURE_MODE: none | transient | permanent | malformed | timeout

# Cloud Run deployment (separate production values; do not use localhost DATABASE_URL).
# GCP_PROJECT=
# GCP_REGION=
# CLOUD_DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# Optional: GCP_REPOSITORY=goblins, GCP_SERVICE_ACCOUNT=goblins-runtime@PROJECT.iam.gserviceaccount.com
