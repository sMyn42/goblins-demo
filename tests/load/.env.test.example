# Copy to .env.test, fill with isolated/test identifiers, and keep the file private.
# This is a shell file; run.sh sources it explicitly. Never put production credentials here.
export LOADTEST_ENVIRONMENT=isolated
export LOADTEST_CONFIRM_ISOLATED=I_CONFIRMED_SEPARATE_LOADTEST_INFRASTRUCTURE

# Dedicated GCP project and deployed test Cloud Run services.
export LOADTEST_GCP_PROJECT=''
export LOADTEST_PRODUCTION_GCP_PROJECT=''
export LOADTEST_GCP_REGION='us-central1'
export LOADTEST_WEB_SERVICE='goblins-loadtest-web'
export LOADTEST_WORKER_SERVICE='goblins-loadtest-worker'
export LOADTEST_BASE_URL=''

# Dedicated Supabase test project; use its PostgreSQL hostname, not a URL, below.
export LOADTEST_DATABASE_URL=''
export LOADTEST_EXPECTED_DATABASE_HOST=''
export LOADTEST_SUPABASE_URL=''
export LOADTEST_STORAGE_BUCKET='goblins-loadtest-work'

# Production identifiers are deny-list checks, not credentials.
export LOADTEST_PRODUCTION_DATABASE_HOST=''
export LOADTEST_PRODUCTION_SUPABASE_URL=''
export LOADTEST_PRODUCTION_STORAGE_BUCKET=''

# Secret Manager names and matching test monitor token.
export LOADTEST_DATABASE_SECRET_NAME='goblins-loadtest-database'
export LOADTEST_STORAGE_SECRET_NAME='goblins-loadtest-storage-key'
export LOADTEST_MONITOR_SECRET_NAME='goblins-loadtest-monitor-token'
export LOADTEST_WORKER_MONITOR_TOKEN=''

# The script generates a unique run ID if this is left empty.
export LOADTEST_RUN_ID=''
export LOADTEST_WORKER_CONCURRENCY='2'

# Optional local setup helper used by npm run setup:storage.
# Keep this test-project service-role key private; it is not needed by Locust.
export LOADTEST_STORAGE_SERVICE_ROLE_KEY=''

# Optional runner settings. Defaults are 5 seconds and 1800 seconds respectively.
# export LOADTEST_SAMPLE_INTERVAL_SECONDS=5
# export LOADTEST_MAX_DRAIN_SECONDS=1800
